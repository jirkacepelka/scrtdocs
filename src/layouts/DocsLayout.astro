---
/**
 * A docs page inside the shell: breadcrumbs, title and description, page actions (Markdown
 * copy, view, download, MDX source, updated date), the jump list below `xl`, the content,
 * previous/next links, and "On this page" on the right.
 */
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import BaseLayout from "./BaseLayout.astro";
import PageActions from "../components/PageActions.astro";
import Toc from "../components/Toc.astro";
import { mdUrl, mdxUrl, pageUrl, type DocPage, type NavEntry } from "../lib/docs";

interface Props {
  page: DocPage;
  entry: NavEntry;
  prev?: NavEntry;
  next?: NavEntry;
  headings: MarkdownHeading[];
}
const { page, entry, prev, next, headings } = Astro.props;
const { title, description, updated, updatedNote } = page.data;
const toc = headings.filter((h) => h.depth === 2);
const crumbs = [
  { label: entry.section.title, href: pageUrl(entry.section.slug) },
  ...(entry.group && entry.group.slug !== page.id
    ? [{ label: entry.group.group, href: entry.group.slug && pageUrl(entry.group.slug) }]
    : []),
];
const filename = `${page.id === "index" ? "quick-setup" : page.id.replaceAll("/", "-")}.md`;
---

<BaseLayout
  title={title}
  description={description}
  current={page.id}
  section={entry.section.title}
  markdown={mdUrl(page.id)}
>
  <article class="docs-article mx-auto max-w-3xl">
    <nav aria-label="Breadcrumb" class="text-sm text-faint">
      <ol class="flex flex-wrap items-center gap-1.5">
        {crumbs.map((c) => (
          <>
            <li>
              {c.href ? (
                <a href={c.href} class="transition-colors hover:text-fg">
                  {c.label}
                </a>
              ) : (
                c.label
              )}
            </li>
            <li aria-hidden="true">/</li>
          </>
        ))}
        <li aria-current="page" class="text-muted">
          {entry.label}
        </li>
      </ol>
    </nav>

    <h1 class="type-doc-title mt-4 text-fg">{title}</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>
    <PageActions
      updated={updated}
      note={updatedNote}
      md={mdUrl(page.id)}
      mdx={mdxUrl(page.id)}
      filename={filename}
    />
    {toc.length > 1 && <Toc headings={toc} variant="select" />}

    <div class="prose-secret mt-10 border-t border-line pt-2">
      <slot />
    </div>

    <nav aria-label="Pagination" class="mt-14 grid gap-3 sm:grid-cols-2">
      {prev ? (
        <a
          href={pageUrl(prev.slug)}
          class="rounded-xl border border-line p-4 transition-colors hover:border-line-strong hover:bg-surface-2"
        >
          <span class="flex items-center gap-1.5 text-xs text-faint">
            <Icon name="ph:arrow-left" class="size-3.5" aria-hidden="true" />
            Previous
          </span>
          <span class="mt-1 block font-medium text-fg">{prev.label}</span>
        </a>
      ) : (
        <span class="hidden sm:block" />
      )}
      {next && (
        <a
          href={pageUrl(next.slug)}
          class="rounded-xl border border-line p-4 text-right transition-colors hover:border-line-strong hover:bg-surface-2"
        >
          <span class="flex items-center justify-end gap-1.5 text-xs text-faint">
            Next
            <Icon name="ph:arrow-right" class="size-3.5" aria-hidden="true" />
          </span>
          <span class="mt-1 block font-medium text-fg">{next.label}</span>
        </a>
      )}
    </nav>
  </article>

  {toc.length > 1 && <Toc slot="toc" headings={toc} />}
</BaseLayout>
