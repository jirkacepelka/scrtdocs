---
/** Starlight's footer (pagination), then the license, publisher and social links. */
import Default from "@astrojs/starlight/components/Footer.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import { site } from "../../data/site.mjs";
---

<Default />
<div class="site-footer">
  <p>
    <a href={site.license.href} target="_blank" rel="noopener noreferrer">
      {site.license.name}
    </a>
    {" · "}
    <a href={site.publisher.href} target="_blank" rel="noopener noreferrer">
      {site.publisher.name}
    </a>
    {" · "}
    <a href={site.mainSite}>scrt.network</a>
  </p>
  <div class="social">
    <SocialIcons />
  </div>
</div>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .site-footer a {
    color: inherit;
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--sl-color-white);
  }
  .social {
    display: flex;
    gap: 1rem;
  }
</style>
