---
/** Logo and "Docs", then the section tabs (from `md`), as on docs.scrt.network. */
import Default from "@astrojs/starlight/components/SiteTitle.astro";
import { sections } from "../../data/site.mjs";

const path = Astro.url.pathname;
---

<div class="site-title-group">
  <Default />
  <nav aria-label="Sections" class="sections">
    {sections.map((s) => (
      <a href={s.href} aria-current={s.match(path) ? "true" : undefined}>
        {s.label}
      </a>
    ))}
  </nav>
</div>

<style>
  .site-title-group {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
  }
  .sections {
    display: none;
    gap: 0.25rem;
  }
  @media (min-width: 72rem) {
    .sections {
      display: flex;
    }
  }
  .sections a {
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .sections a:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  .sections a[aria-current] {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
</style>
