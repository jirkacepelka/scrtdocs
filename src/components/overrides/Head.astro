---
/** Starlight's head, plus a link to the page's Markdown export for agents and tools. */
import Default from "@astrojs/starlight/components/Head.astro";
import { mdUrl } from "../../lib/docs";

const { id } = Astro.locals.starlightRoute;
---

<Default />
<link rel="alternate" type="text/markdown" href={mdUrl(id || "index")} />
