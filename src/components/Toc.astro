---
/**
 * "On this page" from the page's h2 headings, with the one in view highlighted. `variant`
 * "select" is the compact jump list shown above the text below `xl`.
 */
interface Props {
  headings: { slug: string; text: string }[];
  variant?: "list" | "select";
}
const { headings, variant = "list" } = Astro.props;
---

{variant === "select" ? (
  <label class="relative mt-6 block xl:hidden">
    <span class="sr-only">Jump to section</span>
    <select
      data-toc-select
      class="h-10 w-full appearance-none rounded-md border border-line bg-surface pr-9 pl-3 text-sm text-fg focus:border-line-strong focus:outline-none"
    >
      <option value="">On this page</option>
      {headings.map((h) => (
        <option value={h.slug}>{h.text}</option>
      ))}
    </select>
    <span
      class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-faint"
      aria-hidden="true"
    >
      ▾
    </span>
  </label>
) : (
  <nav
    aria-label="On this page"
    class="sticky top-14 max-h-[calc(100dvh-3.5rem)] overflow-y-auto py-10"
  >
    <p class="text-sm font-medium text-fg">On this page</p>
    <ul class="mt-4 space-y-1 border-l border-line text-sm">
      {headings.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            data-toc-link={h.slug}
            class="-ml-px block border-l border-transparent py-1 pl-4 leading-snug text-muted transition-colors hover:text-fg data-[active]:border-accent data-[active]:text-fg"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  // Highlight the last heading that has scrolled past the top third of the viewport.
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
  const targets = links
    .map((l) => document.getElementById(l.dataset.tocLink!))
    .filter((el): el is HTMLElement => !!el);
  const update = () => {
    const line = window.innerHeight / 3;
    let current = targets[0];
    for (const t of targets) if (t.getBoundingClientRect().top < line) current = t;
    for (const l of links) l.toggleAttribute("data-active", l.dataset.tocLink === current?.id);
  };
  if (targets.length) {
    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  document
    .querySelector<HTMLSelectElement>("[data-toc-select]")
    ?.addEventListener("change", (e) => {
      const select = e.currentTarget as HTMLSelectElement;
      if (select.value) location.hash = select.value;
      select.value = "";
    });
</script>
