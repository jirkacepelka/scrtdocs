---
/**
 * Search: a trigger in the header and a modal dialog. Opens with Ctrl/⌘ K or "/". The index
 * (/search.json) is fetched on first open; results match the title, headings and text, with
 * the arrow keys and Enter to move and open.
 */
import { Icon } from "astro-icon/components";
---

<button
  type="button"
  data-search-open
  aria-label="Search docs"
  aria-keyshortcuts="Control+K"
  class="flex h-9 w-9 items-center justify-center gap-2.5 rounded-pill border border-line-strong bg-surface text-sm text-faint transition-colors hover:border-fg/30 hover:text-muted sm:w-60 sm:justify-start sm:px-3.5"
>
  <Icon name="ph:magnifying-glass" class="size-4 shrink-0" aria-hidden="true" />
  <span class="hidden flex-1 text-left sm:inline">Search docs</span>
  <kbd class="hidden rounded-md border border-line px-1.5 font-mono text-[0.6875rem] sm:inline">
    Ctrl K
  </kbd>
</button>

<dialog
  data-search-dialog
  aria-label="Search docs"
  class="m-0 mx-auto mt-[12vh] w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-xl border border-line-strong bg-surface p-0 text-fg backdrop:bg-ink/75 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center gap-3 border-b border-line px-4">
    <Icon name="ph:magnifying-glass" class="size-4 text-faint" aria-hidden="true" />
    <input
      data-search-input
      type="search"
      placeholder="Search docs"
      autocomplete="off"
      spellcheck="false"
      aria-label="Search docs"
      aria-controls="search-results"
      class="h-14 flex-1 bg-transparent text-base text-fg outline-none placeholder:text-faint"
    />
    <kbd class="rounded-md border border-line px-1.5 font-mono text-[0.6875rem] text-faint">
      Esc
    </kbd>
  </div>
  <ul
    id="search-results"
    data-search-results
    role="listbox"
    class="max-h-[55vh] overflow-y-auto p-2"
  ></ul>
  <p data-search-empty class="hidden px-5 py-8 text-center text-sm text-faint">
    No results.
  </p>
</dialog>

<script>
  type Entry = { url: string; title: string; section: string; headings: string[]; text: string };

  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]")!;
  const input = dialog.querySelector<HTMLInputElement>("[data-search-input]")!;
  const list = dialog.querySelector<HTMLUListElement>("[data-search-results]")!;
  const empty = dialog.querySelector<HTMLElement>("[data-search-empty]")!;
  let index: Entry[] | undefined;
  let active = 0;

  const escape = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const mark = (s: string, q: string) => {
    const i = s.toLowerCase().indexOf(q);
    if (i < 0) return escape(s);
    return `${escape(s.slice(0, i))}<mark>${escape(s.slice(i, i + q.length))}</mark>${escape(s.slice(i + q.length))}`;
  };
  const snippet = (text: string, q: string) => {
    const i = text.toLowerCase().indexOf(q);
    if (i < 0) return text.slice(0, 120) + "…";
    const start = Math.max(0, i - 50);
    return (start > 0 ? "…" : "") + text.slice(start, i + q.length + 70) + "…";
  };

  function render() {
    const q = input.value.trim().toLowerCase();
    const results = !index
      ? []
      : !q
        ? index
        : index
            .map((e) => ({
              e,
              score:
                (e.title.toLowerCase().includes(q) ? 3 : 0) +
                (e.headings.some((h) => h.toLowerCase().includes(q)) ? 2 : 0) +
                (e.text.toLowerCase().includes(q) ? 1 : 0),
            }))
            .filter((r) => r.score > 0)
            .sort((a, b) => b.score - a.score)
            .map((r) => r.e);
    active = 0;
    empty.classList.toggle("hidden", results.length > 0 || !index);
    list.innerHTML = results
      .slice(0, 8)
      .map(
        (e, i) => `<li role="option" id="sr-${i}" aria-selected="${i === 0}">
          <a href="${e.url}" class="search-hit block rounded-lg px-3 py-2.5">
            <span class="block font-mono text-[0.6875rem] text-faint">${escape(e.section)}</span>
            <span class="mt-0.5 block font-medium text-fg">${mark(e.title, q)}</span>
            ${q ? `<span class="mt-1 block text-sm leading-relaxed text-muted">${mark(snippet(e.text, q), q)}</span>` : ""}
          </a>
        </li>`,
      )
      .join("");
    input.setAttribute("aria-activedescendant", results.length ? "sr-0" : "");
  }

  function move(step: number) {
    const items = [...list.querySelectorAll<HTMLLIElement>("[role=option]")];
    if (!items.length) return;
    active = (active + step + items.length) % items.length;
    items.forEach((li, i) => li.setAttribute("aria-selected", String(i === active)));
    items[active].scrollIntoView({ block: "nearest" });
    input.setAttribute("aria-activedescendant", items[active].id);
  }

  async function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    if (!index) {
      index = await fetch("/search.json").then((r) => r.json());
    }
    render();
  }

  document.querySelectorAll("[data-search-open]").forEach((b) => b.addEventListener("click", open));
  input.addEventListener("input", render);
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") (e.preventDefault(), move(1));
    if (e.key === "ArrowUp") (e.preventDefault(), move(-1));
    if (e.key === "Enter") {
      const link = list.querySelectorAll<HTMLAnchorElement>("a")[active];
      if (link) location.href = link.href;
    }
  });
  dialog.addEventListener("click", (e) => e.target === dialog && dialog.close());
  document.addEventListener("keydown", (e) => {
    const typing =
      e.target instanceof Element && e.target.closest("input, textarea, [contenteditable]");
    if ((e.key === "k" && (e.metaKey || e.ctrlKey)) || (e.key === "/" && !typing)) {
      e.preventDefault();
      open();
    }
  });
</script>

<style is:global>
  .search-hit mark {
    background: none;
    color: var(--color-accent-300);
  }
  [aria-selected="true"] > .search-hit,
  .search-hit:hover {
    background: var(--color-surface-2);
  }
</style>
