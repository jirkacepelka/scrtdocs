---
/**
 * Under the page title: Copy as Markdown, View as Markdown, Download .md and the MDX source,
 * then when the page was updated. The Markdown is the page's /…/index.md export.
 */
import { Icon } from "@astrojs/starlight/components";

interface Props {
  updated: Date;
  note?: string;
  md: string;
  mdx: string;
  filename: string;
}
const { updated, note, md, mdx, filename } = Astro.props;
const date = updated.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<div class="page-actions not-content">
  <button type="button" class="action" data-copy-md={md}>
    <Icon name="document" size="0.95em" />
    <span data-copy-label aria-live="polite">
      Copy as Markdown
    </span>
  </button>
  <a href={md} target="_blank" rel="noopener noreferrer" class="action">
    <Icon name="external" size="0.95em" />
    View as Markdown
  </a>
  <a href={md} download={filename} class="action">
    <Icon name="download" size="0.95em" />
    Download .md
  </a>
  <a href={mdx} target="_blank" rel="noopener noreferrer" class="action">
    <Icon name="seti:code-search" size="0.95em" />
    MDX source
  </a>
  <span class="updated">
    Updated{note && ` from ${note}`}, <time datetime={updated.toISOString()}>{date}</time>
  </span>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-md]")) {
    const label = button.querySelector<HTMLElement>("[data-copy-label]")!;
    button.addEventListener("click", async () => {
      try {
        const text = await fetch(button.dataset.copyMd!).then((r) => r.text());
        await navigator.clipboard.writeText(text);
        label.textContent = "Copied";
      } catch {
        label.textContent = "Copy failed";
      }
      setTimeout(() => (label.textContent = "Copy as Markdown"), 2000);
    });
  }
</script>

<style>
  .page-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding: 0 0.8rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-xs);
    text-decoration: none;
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s;
  }
  .action:hover {
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .updated {
    margin-inline-start: auto;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
