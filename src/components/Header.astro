---
/**
 * Docs top bar: logo and "Docs" over the sidebar column, the section tabs, search, the
 * full-width toggle and a link to scrt.network. Below `lg` a menu button opens the sidebar
 * as a drawer (a modal <dialog>).
 */
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import Search from "./Search.astro";
import Sidebar from "./Sidebar.astro";
import { nav, site } from "../data/site";
import { pageUrl } from "../lib/docs";

interface Props {
  current?: string;
  /** Title of the section the current page belongs to. */
  section?: string;
}
const { current, section } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-line bg-ink/85 backdrop-blur-xl">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:rounded-pill focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent"
  >
    Skip to content
  </a>
  <div class="docs-grid mx-auto flex h-14 max-w-[90rem] items-center gap-3 px-4 md:gap-4 md:px-6">
    <button
      type="button"
      data-drawer-open
      aria-label="Open navigation"
      class="-ml-1.5 inline-flex size-9 shrink-0 items-center justify-center rounded-pill text-muted hover:bg-surface-2 hover:text-fg lg:hidden"
    >
      <Icon name="ph:list" class="size-5" aria-hidden="true" />
    </button>
    <a href="/" class="flex shrink-0 items-center gap-3 text-fg lg:w-[calc(16rem-1.5rem)]">
      <Logo class="h-5 w-auto" title="Secret Network" />
      <span class="h-4 w-px bg-line-strong" aria-hidden="true"></span>
      <span class="text-sm font-medium">Docs</span>
    </a>
    <nav aria-label="Sections" class="hidden md:block">
      <ul class="flex gap-1 text-sm">
        {nav.map((s) => (
          <li>
            <a
              href={pageUrl(s.slug)}
              aria-current={s.title === section ? "true" : undefined}
              class:list={[
                "rounded-pill px-3 py-1.5 transition-colors",
                s.title === section
                  ? "bg-surface-2 text-fg"
                  : "text-muted hover:bg-surface-2 hover:text-fg",
              ]}
            >
              {s.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-1.5 md:gap-2">
      <Search />
      <button
        type="button"
        data-wide-toggle
        aria-pressed="false"
        title="Full width"
        class="hidden size-9 items-center justify-center rounded-pill text-muted transition-colors hover:bg-surface-2 hover:text-fg aria-pressed:bg-surface-2 aria-pressed:text-accent-300 lg:inline-flex"
      >
        <Icon name="ph:arrows-out-line-horizontal" class="size-[1.125rem]" aria-hidden="true" />
        <span class="sr-only">Full width</span>
      </button>
      <a
        href={site.mainSite}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1 pl-2 text-sm text-muted transition-colors hover:text-fg xl:inline-flex"
      >
        scrt.network
        <Icon name="ph:arrow-up-right" class="size-3.5" aria-hidden="true" />
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>
  </div>
</header>

<dialog
  data-drawer
  aria-label="Navigation"
  class="m-0 h-dvh max-h-none w-[min(20rem,85vw)] border-r border-line bg-ink p-0 text-fg backdrop:bg-ink/70"
>
  <div class="flex h-14 items-center justify-between border-b border-line px-4">
    <span class="text-sm font-medium">Navigation</span>
    <button
      type="button"
      data-drawer-close
      aria-label="Close navigation"
      class="inline-flex size-9 items-center justify-center rounded-pill text-muted hover:bg-surface-2 hover:text-fg"
    >
      <Icon name="ph:x" class="size-5" aria-hidden="true" />
    </button>
  </div>
  <div class="px-3 py-5">
    <Sidebar current={current} />
  </div>
</dialog>

<script>
  const drawer = document.querySelector<HTMLDialogElement>("[data-drawer]")!;
  document.querySelector("[data-drawer-open]")?.addEventListener("click", () => drawer.showModal());
  document.querySelector("[data-drawer-close]")?.addEventListener("click", () => drawer.close());
  drawer.addEventListener("click", (e) => e.target === drawer && drawer.close());

  // Full width: a class on <html> (set before paint in BaseLayout), remembered per browser.
  const toggle = document.querySelector<HTMLButtonElement>("[data-wide-toggle]")!;
  const root = document.documentElement;
  toggle.setAttribute("aria-pressed", String(root.hasAttribute("data-wide")));
  toggle.addEventListener("click", () => {
    const wide = root.toggleAttribute("data-wide");
    toggle.setAttribute("aria-pressed", String(wide));
    try {
      localStorage.setItem("docs:wide", wide ? "1" : "");
    } catch {}
  });
</script>
