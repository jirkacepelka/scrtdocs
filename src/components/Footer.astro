---
/** Footer under the page: license and publisher on the left, social links on the right. */
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import { site, socialLinks } from "../data/site";
---

<footer class="docs-article mx-auto mt-20 max-w-3xl border-t border-line pt-8">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-3">
      <Logo class="h-5 w-auto text-fg" decorative />
      <p class="text-xs text-faint">
        <a
          href={site.license.href}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-fg"
        >
          {site.license.name}
        </a>
        {" · "}
        <a
          href={site.publisher.href}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-fg"
        >
          {site.publisher.name}
        </a>
        {" · "}
        <a href={site.mainSite} class="transition-colors hover:text-fg">
          scrt.network
        </a>
      </p>
    </div>
    <ul class="flex gap-2" aria-label="Social">
      {socialLinks.map((s) => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex size-9 items-center justify-center rounded-pill border border-line text-muted transition-colors hover:border-line-strong hover:text-fg"
          >
            <Icon name={s.icon} class="size-4" aria-hidden="true" />
            <span class="sr-only">{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
