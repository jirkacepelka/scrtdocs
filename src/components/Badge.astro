---
/** Small status / category label. `tone="accent"` for highlights, "soon" for upcoming features. */
interface Props {
  tone?: "neutral" | "accent" | "soon";
  class?: string;
}
const { tone = "neutral", class: className } = Astro.props;
const tones = {
  neutral: "border-line-strong text-muted",
  accent: "border-accent/40 bg-accent-900 text-accent-200",
  soon: "border-line-strong text-fg",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5 font-mono text-[0.75rem] leading-5 tracking-tight",
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
