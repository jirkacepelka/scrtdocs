---
/**
 * Secret Network logo, inlined so it inherits `currentColor`.
 * Source: scrt.network/icons/secret-wordmark.svg (split into symbol + wordmark).
 * Static copies live in public/brand/. Use `decorative` for purely visual uses.
 */
import { symbolPath, wordmarkPath } from "./logo-paths";

interface Props {
  variant?: "full" | "symbol";
  class?: string;
  style?: string;
  title?: string;
  decorative?: boolean;
}

const {
  variant = "full",
  class: className,
  style,
  title = "Secret Network",
  decorative = false,
} = Astro.props;
const a11y = decorative
  ? { "aria-hidden": "true" as const }
  : { role: "img" as const, "aria-label": title };
---

{variant === "symbol" ? (
  <svg viewBox="0 0 24.623 24.937" class={className} style={style} fill="currentColor" {...a11y}>
    <path d={symbolPath} />
  </svg>
) : (
  <svg viewBox="0 0 98.988 25" class={className} style={style} fill="currentColor" {...a11y}>
    <path d={symbolPath} />
    <path d={wordmarkPath} />
  </svg>
)}
