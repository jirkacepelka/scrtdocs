---
/**
 * Tab set for <TabItem> panels. The tab buttons are built from the panels' labels on the
 * client. Tab sets with the same `syncKey` switch together, and the choice is remembered.
 */
interface Props {
  syncKey?: string;
}
const { syncKey } = Astro.props;
---

<div class="tabs" data-tabs data-sync-key={syncKey}>
  <div role="tablist" class="tab-list"></div>
  <slot />
</div>

<script>
  const store = {
    get: (k: string) => {
      try {
        return localStorage.getItem(`tabs:${k}`);
      } catch {
        return null;
      }
    },
    set: (k: string, v: string) => {
      try {
        localStorage.setItem(`tabs:${k}`, v);
      } catch {}
    },
  };
  const sets = [...document.querySelectorAll<HTMLElement>("[data-tabs]")];

  function select(set: HTMLElement, label: string) {
    const panels = [...set.querySelectorAll<HTMLElement>(":scope > [role=tabpanel]")];
    const buttons = [
      ...set.querySelectorAll<HTMLButtonElement>(":scope > [role=tablist] > button"),
    ];
    const index = Math.max(
      0,
      panels.findIndex((p) => p.dataset.tabLabel === label),
    );
    panels.forEach((p, i) => (p.hidden = i !== index));
    buttons.forEach((b, i) => {
      b.setAttribute("aria-selected", String(i === index));
      b.tabIndex = i === index ? 0 : -1;
    });
  }

  sets.forEach((set, n) => {
    const list = set.querySelector<HTMLElement>(":scope > [role=tablist]")!;
    const panels = [...set.querySelectorAll<HTMLElement>(":scope > [role=tabpanel]")];
    const key = set.dataset.syncKey;
    panels.forEach((panel, i) => {
      const id = `tab-${n}-${i}`;
      panel.id = `${id}-panel`;
      panel.setAttribute("aria-labelledby", id);
      const button = document.createElement("button");
      button.type = "button";
      button.role = "tab";
      button.id = id;
      button.className = "tab-button";
      button.textContent = panel.dataset.tabLabel!;
      button.setAttribute("aria-controls", panel.id);
      button.addEventListener("click", () => {
        const label = panel.dataset.tabLabel!;
        if (key) {
          store.set(key, label);
          sets.filter((s) => s.dataset.syncKey === key).forEach((s) => select(s, label));
        } else select(set, label);
      });
      button.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        const buttons = [...list.querySelectorAll<HTMLButtonElement>("button")];
        const next = buttons[(i + step + buttons.length) % buttons.length];
        next.click();
        next.focus();
      });
      list.append(button);
    });
    set.classList.add("is-ready");
    select(set, (key && store.get(key)) || panels[0]?.dataset.tabLabel || "");
  });
</script>
