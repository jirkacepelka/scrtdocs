---
/**
 * Navigation tree from src/data/site.ts: sections and collapsible groups (open when they hold
 * the current page), with a filter box. Rendered in the desktop sidebar and the mobile drawer.
 */
import { Icon } from "astro-icon/components";
import Badge from "./Badge.astro";
import { nav, type NavGroup, type NavPage } from "../data/site";
import { getPages, isGroup, pageUrl } from "../lib/docs";

interface Props {
  current?: string;
}
const { current } = Astro.props;
const pages = await getPages();
const label = (p: NavPage) => p.label ?? pages.get(p.slug)?.data.title ?? p.slug;
const flatSlugs = (items: (NavPage | NavGroup)[]) =>
  items.flatMap((i) => (isGroup(i) ? [i.slug ?? "", ...i.items.map((p) => p.slug)] : [i.slug]));
const holds = (g: NavGroup) => g.slug === current || g.items.some((i) => i.slug === current);
const link = (active: boolean) => [
  "block rounded-md px-3 py-1.5 text-sm leading-snug transition-colors",
  active ? "bg-accent-900/50 text-accent-200" : "text-muted hover:bg-surface-2 hover:text-fg",
];
const summary =
  "flex cursor-pointer list-none items-center justify-between gap-2 rounded-md px-3 py-1.5 text-sm text-fg hover:bg-surface-2 [&::-webkit-details-marker]:hidden";
const caret = "size-3.5 shrink-0 text-faint transition-transform group-open/d:rotate-90";
---

<div data-sidebar>
  <label class="relative block">
    <span class="sr-only">Filter navigation</span>
    <Icon
      name="ph:funnel-simple"
      class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-faint"
      aria-hidden="true"
    />
    <input
      type="search"
      data-sidebar-filter
      placeholder="Filter…"
      autocomplete="off"
      class="h-9 w-full rounded-md border border-line bg-surface pr-3 pl-9 text-sm text-fg placeholder:text-faint focus:border-line-strong focus:outline-none"
    />
  </label>

  <nav aria-label="Docs" class="mt-5">
    <ul class="space-y-4">
      {nav.map((section) => {
        const inSection = flatSlugs(section.items).includes(current ?? "");
        return (
          <li>
            <details open={inSection || undefined} class="group/d" data-nav-group>
              <summary class={summary}>
                <span class="flex items-center gap-2 font-medium">
                  {section.title}
                  {section.draft && <Badge class="px-1.5 py-0 text-[0.625rem]">Draft</Badge>}
                </span>
                <Icon name="ph:caret-right" class={caret} aria-hidden="true" />
              </summary>
              <ul class="mt-1 space-y-0.5 border-l border-line pl-2 ml-3">
                {section.items.map((item) =>
                  isGroup(item) ? (
                    <li>
                      <details open={holds(item) || undefined} class="group/d" data-nav-group>
                        <summary class:list={[summary, "text-muted"]}>
                          {item.slug ? (
                            <a
                              href={pageUrl(item.slug)}
                              data-nav-link
                              aria-current={item.slug === current ? "page" : undefined}
                              class:list={[
                                item.slug === current ? "text-accent-200" : "hover:text-fg",
                              ]}
                            >
                              {item.group}
                            </a>
                          ) : (
                            <span>{item.group}</span>
                          )}
                          <Icon name="ph:caret-right" class={caret} aria-hidden="true" />
                        </summary>
                        <ul class="mt-0.5 ml-3 space-y-0.5 border-l border-line pl-2">
                          {item.items.map((p) => (
                            <li>
                              <a
                                href={pageUrl(p.slug)}
                                data-nav-link
                                aria-current={p.slug === current ? "page" : undefined}
                                class:list={link(p.slug === current)}
                              >
                                {label(p)}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  ) : (
                    <li>
                      <a
                        href={pageUrl(item.slug)}
                        data-nav-link
                        aria-current={item.slug === current ? "page" : undefined}
                        class:list={link(item.slug === current)}
                      >
                        {label(item)}
                      </a>
                    </li>
                  ),
                )}
              </ul>
            </details>
          </li>
        );
      })}
    </ul>
    <p data-sidebar-empty hidden class="px-3 py-2 text-sm text-faint">
      No pages match.
    </p>
  </nav>
</div>

<script>
  // Filter: hide links that don't match, open groups that hold a match.
  for (const root of document.querySelectorAll<HTMLElement>("[data-sidebar]")) {
    const input = root.querySelector<HTMLInputElement>("[data-sidebar-filter]")!;
    const empty = root.querySelector<HTMLElement>("[data-sidebar-empty]")!;
    const links = [...root.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]")];
    // Innermost groups first, so a section sees its groups' final state.
    const groups = [...root.querySelectorAll<HTMLDetailsElement>("[data-nav-group]")].reverse();
    const initial = new Map(groups.map((g) => [g, g.open]));
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      for (const a of links) {
        a.dataset.hit = !q || a.textContent!.toLowerCase().includes(q) ? "1" : "";
        if (!a.closest("summary")) a.closest("li")!.hidden = !a.dataset.hit;
      }
      for (const g of groups) {
        const has = [...g.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]")].some(
          (a) => a.dataset.hit,
        );
        g.open = q ? has : initial.get(g)!;
        g.parentElement!.hidden = !!q && !has;
      }
      empty.hidden = !q || links.some((a) => a.dataset.hit);
    });
  }
</script>
