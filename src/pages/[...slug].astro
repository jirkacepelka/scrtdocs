---
import { render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import Flowchart from "../components/mdx/Flowchart.astro";
import Tabs from "../components/mdx/Tabs.astro";
import TabItem from "../components/mdx/TabItem.astro";
import SetupNodeCurl from "../components/mdx/SetupNodeCurl.astro";
import RestoreCurl from "../components/mdx/RestoreCurl.astro";
import { flatNav, getPages, type DocPage, type NavEntry } from "../lib/docs";

export async function getStaticPaths() {
  const pages = await getPages();
  const order = flatNav(pages);
  const missing = [...pages.keys()].filter((id) => !order.some((e) => e.slug === id));
  if (missing.length) throw new Error(`docs: pages missing from nav in data/site.ts: ${missing}`);
  return order.map((entry, i) => ({
    params: { slug: entry.slug === "index" ? undefined : entry.slug },
    props: { page: pages.get(entry.slug)!, entry, prev: order[i - 1], next: order[i + 1] },
  }));
}

interface Props {
  page: DocPage;
  entry: NavEntry;
  prev?: NavEntry;
  next?: NavEntry;
}
const { page, entry, prev, next } = Astro.props;
const { Content, headings } = await render(page);
---

<DocsLayout page={page} entry={entry} prev={prev} next={next} headings={headings}>
  <Content components={{ Flowchart, Tabs, TabItem, SetupNodeCurl, RestoreCurl }} />
</DocsLayout>
