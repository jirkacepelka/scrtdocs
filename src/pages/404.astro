---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="docs-article mx-auto max-w-3xl py-16">
    <p class="font-mono text-sm text-accent-300">404</p>
    <h1 class="type-doc-title mt-4 text-fg">
      Page not found. <em>It may have moved.</em>
    </h1>
    <p class="mt-4 text-muted">Use the navigation or search (Ctrl K) to find the page.</p>
    <a
      href="/"
      class="mt-8 inline-flex h-10 items-center rounded-pill bg-accent px-5 text-sm font-medium text-on-accent transition-colors hover:bg-accent-300"
    >
      Quick Setup
    </a>
  </section>
</BaseLayout>
